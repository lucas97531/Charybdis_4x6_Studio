#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        mmt: mmt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        skl: skl {
            compatible = "zmk,behavior-sticky-key";
            label = "skl";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        skm: sticky_modif {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
        };

        // Define your custom delayed layer-tap behavior

        lt_delay: layer_tap_delay {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";         // Enforces the time lag
            tapping-term-ms = <300>;           // Your time lag duration (e.g., 300ms)
            bindings = <&mo>, <&kp>;

            // Hold triggers momentary layer, tap triggers keypress
        };
    };
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_context_0_Layer {
            bindings = <
&kp GRAVE       &kp SEMI         &kp LEFT_BRACKET  &kp QUESTION         &kp RIGHT_BRACKET      &kp EXCL                &kp EQUAL           &kp LEFT_PARENTHESIS  &kp UNDER             &kp RIGHT_PARENTHESIS  &kp COLON         &kp TILDE
&kp TAB         &kp Q            &kp W             &kp E                &mmt LEFT_GUI R        &kp T                   &kp Y               &mmt RIGHT_GUI U      &kp I                 &kp O                  &kp P             &kp BSLH
&kp CAPSLOCK    &lt_delay 12 A   &lt 4 S           &mmt LEFT_CONTROL D  &lt_delay 13 F         &kp G                   &kp H               &kp J                 &mmt RIGHT_CONTROL K  &kp L                  &skm RIGHT_SHIFT  &kp SQT
&kp LEFT_SHIFT  &mmt LEFT_ALT Z  &kp X             &kp C                &kp V                  &lt 2 B                 &kp N               &kp M                 &kp COMMA             &kp DOT                &kp LEFT_ALT      &kp RIGHT_SHIFT
                                                   &kp LEFT_CONTROL     &lt (9) RC(RA(SPACE))  &lt (23) RC(RA(TAB))    &lt (11) LS(LG(S))  &sl 14
                                                                        &kp LS(ENTER)          &lt 10 C_MUTE           &kp CAPSLOCK
            >;
        };

        Base_context_1_Layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
